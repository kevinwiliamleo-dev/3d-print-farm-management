# Frontend Dockerfile - Serve pre-built static files
# Build happens in GitHub Actions runner, not in Docker
FROM nginx:alpine

# Copy pre-built build folder (context is now frontend/, so build/ is at root of context)
COPY build /usr/share/nginx/html

# Expose port
EXPOSE 3051

# Custom nginx config for React Router (if needed)
RUN echo 'server { \
    listen 3051; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

CMD ["nginx", "-g", "daemon off;"]
