# ============================================
# 3D Print Farm Management System
# Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ==================== Server Settings ====================
# API host and port configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
RELOAD=true

# ==================== Database Settings ====================
# SQLite database path (relative or absolute)
DATABASE_URL=sqlite:///./data/farm.db

# ==================== Bambu Lab Cloud Credentials ====================
# Your Bambu Lab account credentials for Cloud API access
# Get these from your Bambu Lab account at bambulab.com
BAMBU_USERNAME=your_email@example.com
BAMBU_PASSWORD=your_password
BAMBU_PRINTER_ID=your_printer_serial_number
BAMBU_REGION=us

# ==================== MQTT Settings ====================
# For direct printer communication via local network
# Leave empty if using Cloud API only
MQTT_BROKER=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# ==================== OrcaSlicer Settings ====================
# Path to OrcaSlicer executable
# Windows: C:/Program Files/OrcaSlicer/OrcaSlicer.exe
# Linux: /usr/bin/orca-slicer
# macOS: /Applications/OrcaSlicer.app/Contents/MacOS/OrcaSlicer
ORCA_SLICER_PATH=orca-slicer
SLICING_TIMEOUT_SECONDS=300

# ==================== Default Print Settings ====================
DEFAULT_LAYER_HEIGHT=0.2
DEFAULT_INFILL_DENSITY=15

# ==================== File Upload Settings ====================
MAX_UPLOAD_SIZE_MB=500

# ==================== CORS Settings ====================
# Comma-separated list of allowed origins for frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ==================== Logging Settings ====================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==================== Feature Flags ====================
ENABLE_AUTO_EJECT=true
ENABLE_MQTT=true
ENABLE_ORCA_INTEGRATION=true

# ==================== Queue Settings ====================
QUEUE_CHECK_INTERVAL_SECONDS=5
AUTO_START_NEXT_JOB=true

# ==================== API Settings ====================
API_TIMEOUT_SECONDS=30
